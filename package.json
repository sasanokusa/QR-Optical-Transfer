{
  "name": "qr-optical-transfer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:protocol": "node --experimental-strip-types scripts/protocol-smoke.mjs",
    "test:repair": "node --experimental-strip-types scripts/repair-smoke.mjs",
    "test:qr": "node --experimental-strip-types scripts/qr-smoke.mjs",
    "test:receiver": "node --experimental-strip-types scripts/receiver-smoke.mjs",
    "test": "npm run build && npm run test:protocol && npm run test:repair && npm run test:qr && npm run test:receiver && npm run test:ui",
    "test:ui": "node --experimental-strip-types scripts/ui-smoke.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "linkedom": "^0.18.13",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
